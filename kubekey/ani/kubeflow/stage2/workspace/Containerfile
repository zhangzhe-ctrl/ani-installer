# Built on Fedora from a digest-pinned Python base and a closed wheel set.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}
COPY wheels/ /opt/wheels/
COPY requirements.lock /opt/requirements.lock
RUN python -m pip install --no-index --find-links=/opt/wheels --require-hashes -r /opt/requirements.lock \
    && python -m pip check \
    && rm -r /opt/wheels \
    && mkdir -p /home/jovyan /opt/ani \
    && chown 1000:1000 /home/jovyan
COPY model.py /opt/ani/model.py
ENV HOME=/home/jovyan PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=/opt/ani
USER 1000:1000
WORKDIR /home/jovyan
EXPOSE 8888
CMD ["jupyter", "lab", "--ip=0.0.0.0", "--port=8888", "--no-browser", "--ServerApp.root_dir=/home/jovyan"]
